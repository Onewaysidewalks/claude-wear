{
  "name": "claude-wear-bridge",
  "version": "0.1.0",
  "description": "Owns N live Claude Agent SDK sessions and speaks the claude-wear protocol to a watch.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "claude-wear-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "codegen": "node ../protocol/codegen/generate.mjs",
    "codegen:check": "node ../protocol/codegen/generate.mjs --check",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "dev": "npm run build && FAKE_AGENT=1 node dist/cli.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
