{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server/error.schema.json",
  "title": "ErrorEvent",
  "description": "Something the client asked for did not happen. Connection-scoped errors use the reserved '@registry' sessionId.",
  "x-message": { "direction": "server", "type": "error" },
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "sessionId", "seq", "code", "message", "requestId"],
  "properties": {
    "type": { "const": "error" },
    "sessionId": { "type": "string" },
    "seq": { "type": "integer" },
    "code": { "$ref": "common.schema.json#/$defs/ErrorCode" },
    "message": { "type": "string" },
    "requestId": { "type": ["string", "null"] }
  }
}
